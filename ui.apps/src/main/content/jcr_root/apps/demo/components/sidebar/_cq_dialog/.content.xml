<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="ZAVÉLUNE Sidebar"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">

                <items jcr:primaryType="nt:unstructured">

                    <!-- TAB 1: HEADER -->
                    <header
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Header"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <logoPath
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo Path"
                                name="./logoPath"
                                rootPath="/content/dam"/>

                            <logoMobileImage
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo Mobile Image"
                                name="./logoMobileImage"
                                rootPath="/content/dam"/>

                            <logoLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo Link"
                                name="./logoLink"
                                rootPath="/content"/>

                            <enableSwitch
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Enable Header"
                                name="./enableSwitch"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"
                                checked="{Boolean}true"/>

                        </items>
                    </header>

                    <!-- TAB 2: HEADER LINKS -->
                    <headerLinksTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Header Links"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <headerLinks
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Header Links">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./headerLinks">

                                    <items jcr:primaryType="nt:unstructured">

                                        <name
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Name"
                                            name="./name"/>

                                        <image
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Image"
                                            name="./image"
                                            rootPath="/content/dam"/>

                                    </items>
                                </field>
                            </headerLinks>

                        </items>
                    </headerLinksTab>

                    <!-- TAB 3: SIDEBAR NAVIGATION -->
                    <sideBarNavigationTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="SideBar Navigation"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <sideBarNavigation
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="SideBar Navigation">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./sideBarNavigation">

                                    <items jcr:primaryType="nt:unstructured">

                                        <desktopIcon
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Desktop Icon"
                                            name="./desktopIcon"
                                            rootPath="/content/dam"/>

                                        <mobileIcon
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Mobile Icon"
                                            name="./mobileIcon"
                                            rootPath="/content/dam"/>

                                        <!-- NESTED MULTIFIELD -->
                                        <navigationItems
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                            composite="{Boolean}true"
                                            fieldLabel="Navigation URLs">

                                            <field
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                name="./navigationItems">

                                                <items jcr:primaryType="nt:unstructured">
                                                    <name
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                        fieldLabel="Navigation Name"
                                                        name="./navigationName"
                                                        required="{Boolean}true"/>

                                                    <navigationURL
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                        fieldLabel="Navigation URL"
                                                        name="./navigationURL"
                                                        rootPath="/content"/>

                                                </items>
                                            </field>
                                        </navigationItems>

                                    </items>
                                </field>
                            </sideBarNavigation>

                        </items>
                    </sideBarNavigationTab>

                    <!-- TAB 4: REGION -->
                    <region
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Region"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <country
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Country"
                                name="./country">

                                <items jcr:primaryType="nt:unstructured">

                                    <india
                                        jcr:primaryType="nt:unstructured"
                                        text="India"
                                        value="india"/>

                                    <us
                                        jcr:primaryType="nt:unstructured"
                                        text="US"
                                        value="us"/>

                                </items>
                            </country>

                        </items>
                    </region>

                </items>
            </tabs>

        </items>
    </content>
</jcr:root>
